# ==============================================================================
# ISC ATS Backend — Variables de Entorno de Ejemplo (.env.example)
# ==============================================================================
# Copie este archivo como `.env` y ajuste los valores según su entorno:
# cp .env.example .env
# ==============================================================================

# --- Aplicación ---
APP_NAME="ISC ATS Backend"
ENVIRONMENT=development                # development | production | testing
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Base de Datos PostgreSQL ---
# Requiere PostgreSQL 15+ (con extensión pgvector habilitada en la BD)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/isc_ats
SQL_ECHO=false

# --- Almacenamiento de Archivos (MinIO / S3) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=candidates-cvs
MINIO_SECURE=false                     # true para HTTPS/TLS en producción
CV_MAX_ACTIVE_PER_USER=10
CV_MAX_TOTAL_BYTES_PER_USER=52428800    # 50 MB límite por candidato

# --- Seguridad y Autenticación JWT ---
JWT_SECRET_KEY=cambiar-por-un-secret-muy-seguro-en-produccion-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate Limiting & Proxy ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://       # Para múltiples réplicas en prod: redis://redis:6379/1
TRUST_PROXY_HEADERS=false              # true solo si el backend está detrás de proxy inverso (Next.js/Nginx)

# --- Cloudflare Turnstile (Anti-bot en Registro y Login) ---
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- Cola de Tareas en Background & Denylist de Tokens (Redis / Arq) ---
# "inline" ejecuta tareas en el mismo proceso (ideal para desarrollo local y tests sin Redis).
# "arq" encola tareas en Redis para que las procese el worker separado (imprescindible en producción).
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# --- Inteligencia Artificial (LLM & Embeddings) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Servicio de Correo Electrónico (Email) ---
EMAIL_PROVIDER=smtp                    # "smtp" (Gmail) o "resend"
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_SENDER_NAME="Integrity Solutions"
EMAIL_SENDER_EMAIL=notificaciones@isc.com

# Configuración SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Configuración Resend (si EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# --- Integración con Microsoft Teams (Reuniones / Entrevistas) ---
# "disabled" para desarrollo sin Azure o "graph" para crear reuniones reales vía Microsoft Graph
MEETINGS_PROVIDER=disabled
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Integración Externa TMR (.NET System Mirror) ---
# Dejar en blanco para desactivar sincronización en desarrollo
TMR_BASE_URL=
TMR_USER=
TMR_PASSWORD=
